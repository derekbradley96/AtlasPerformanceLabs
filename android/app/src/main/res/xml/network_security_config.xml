<?xml version="1.0" encoding="utf-8"?>
<network-security-config>

  <!-- Production: HTTPS only, no cleartext permitted -->
  <domain-config cleartextTrafficPermitted="false">
    <domain includeSubdomains="true">atlasperformancelabs.co.uk</domain>
    <domain includeSubdomains="true">supabase.co</domain>
    <domain includeSubdomains="true">stripe.com</domain>
  </domain-config>

  <!-- Development: allow localhost cleartext for dev server -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">localhost</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <!-- Add your local IP if testing on physical device: -->
    <!-- <domain includeSubdomains="false">192.168.1.x</domain> -->
  </domain-config>

  <!-- Default: block cleartext for all other domains -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>

</network-security-config>
