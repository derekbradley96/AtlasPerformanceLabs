  },
  "overrides": {
    "minimatch": "^9.0.7",
    "tar": "^7.0.0",
    "file-type": "^21.3.2",
    "quill": "^2.0.3",
    "@xmldom/xmldom": "^0.8.13",
    "ws": "^8.21.0",
    "protobufjs": "^7.6.5",
    "fast-uri": "^3.1.3",
    "tmp": "^0.2.6"
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --fix"
  }
}
