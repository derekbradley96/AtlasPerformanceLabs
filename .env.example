# WARNING: Never commit .env.local. Rotate any key that was ever in a committed file.
# Server-only secrets go in Vercel Dashboard > Settings > Environment Variables.
# Client-safe vars also go there, but may be in .env.local for local dev.

# SERVER-ONLY SECRETS (never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_URL=postgresql://user:password@host:5432/dbname
POSTGRES_PRISMA_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true&connect_timeout=15
POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/dbname
RESEND_API_KEY=re_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
CRON_SECRET=<generate-random-32-char>
INTERNAL_WEBHOOK_SECRET=<generate-random-32-char>

# CLIENT-SAFE (VITE_ prefix ok)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
VITE_GLITCHTIP_DSN=https://key@app.glitchtip.com/123
VITE_POSTHOG_KEY=phc_your_key_here

# WebRTC TURN relay (calls across different networks). These are EDGE FUNCTION
# secrets (supabase secrets set), NOT VITE_ vars — TURN credentials must never
# ship in the client bundle. Served to signed-in users by turn-credentials.
# Get from metered.ca, Twilio NTS, Cloudflare Calls, or self-hosted coturn.
# TURN_URLS=turn:host:443,turns:host:443
# TURN_USERNAME=
# TURN_CREDENTIAL=
